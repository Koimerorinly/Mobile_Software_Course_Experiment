/* 页面容器样式 */
page {
  background: linear-gradient(135deg, #fff5f5 0%, #ffe8e8 100%);
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 40rpx 0;
  box-sizing: border-box;
}

/* 顶端标题样式 */
.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #E64340;
  letter-spacing: 4rpx;
}