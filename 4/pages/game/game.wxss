/* 自定义导航栏 */
.navbar {
  width: 100%;
  height: 88rpx;

  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 999;
  padding-top: 45px;
}

.navbar-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #666666;
  letter-spacing: 6rpx;
}

/* 返回按钮 */
.navbar-back {
  position: absolute;
  left: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.15);
  margin-top: 44rpx;
}

.navbar-back:active {
  background: rgba(255, 255, 255, 0.3);
}

.back-icon {
  font-size: 48rpx;
  color: #ffffff;
  font-weight: 300;
  line-height: 1;
  margin-right: 4rpx;
}

.back-text {
  font-size: 26rpx;
  color: #ffffff;
}

/* 页面容器 - 覆盖全局容器 */
.container {
  min-height: calc(100vh - 88rpx);
  background: linear-gradient(180deg, #fff5f5 0%, #ffe8e8 100%);
  padding: 20rpx 0 30rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 游戏头部 */
.game-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.header-right {
  display: flex;
  align-items: center;
}

.steps-display {
  background: rgba(230, 67, 64, 0.1);
  color: #E64340;
  font-size: 28rpx;
  font-weight: bold;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  border: 2rpx solid rgba(230, 67, 64, 0.2);
}

.level-badge {
  background: linear-gradient(135deg, #E64340, #c0392b);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
  padding: 8rpx 32rpx;
  border-radius: 30rpx;
  letter-spacing: 2rpx;
}

.level-name {
  font-size: 28rpx;
  color: #666666;
}

/* 画布包装 */
.canvas-wrapper {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 12rpx;
  box-shadow: 0 12rpx 40rpx rgba(230, 67, 64, 0.12);
  border: 2rpx solid rgba(230, 67, 64, 0.06);
}

/* 游戏画布 - 放大尺寸 */
#myCanvas {
  width: 640rpx;
  height: 640rpx;
  border-radius: 12rpx;
  background-color: #f0f8ff;
}

/* 方向键区域 */
.btnBox {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 30rpx;
  gap: 16rpx;
}

.dir-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

/* 方向键区域 */
.btnBox {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 30rpx;
  gap: 10rpx;
}

.dir-row {
  display: flex;
  flex-direction: row;
  gap: 10rpx;
}

/* 方向键按钮 - 正圆形 */
.dir-btn {
  width: 80rpx;
  height: 80rpx;
  /* 宽高相等，确保正圆 */
  min-width: 80rpx;
  min-height: 80rpx;
  max-width: 80rpx;
  max-height: 80rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  border-radius: 50%;
  /* 圆形 */
  background: linear-gradient(145deg, #ffffff, #f0e8e8);
  color: palevioletred;
  font-weight: 400;
  box-shadow: 0 4rpx 16rpx rgba(230, 67, 64, 0.15), 
              inset 0 -4rpx 8rpx rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1;
  transition: all 0.15s ease;
  box-sizing: border-box;
  /* 防止内边距影响尺寸 */
  flex-shrink: 0;
  /* 防止被压缩 */;
}

.dir-btn:active {
  transform: scale(0.92);
  box-shadow: 0 2rpx 8rpx rgba(230, 67, 64, 0.2);
  background: linear-gradient(145deg, #f0e8e8, #ffffff);
}

/* 上方向键单独上移 */
.dir-up {
  margin-bottom: -2rpx;
  color: palevioletred;
}
/* 下方向键在行内微调 */
.dir-down {
  /* 保持和其他按钮一致 */
}

/* 底部按钮区域 */
.bottom-btns {
  margin-top: 30rpx;
  display: flex;
  gap: 30rpx;
}

/* 重新开始按钮 */
.restart-btn {
  background: pink;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
  padding: 16rpx 60rpx;
  border-radius: 50rpx;
  border: none;
  box-shadow: 0 8rpx 25rpx rgba(230, 67, 64, 0.3);
  transition: all 0.2s ease;
  letter-spacing: 2rpx;
}

.restart-btn:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 15rpx rgba(230, 67, 64, 0.2);
}
/* 撤回按钮 */
.undo-btn {
  background-color: aquamarine;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
  padding: 16rpx 40rpx;
  border-radius: 50rpx;
  border: none;
  box-shadow: 0 8rpx 25rpx rgba(127, 83, 146, 0.3);
  transition: all 0.2s ease;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.undo-btn:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 15rpx rgba(243, 156, 18, 0.2);
}

.undo-btn[disabled] {
  opacity: 0.5;
  transform: none;
  box-shadow: 0 4rpx 15rpx rgba(243, 156, 18, 0.1);
}

.undo-tip {
  font-size: 22rpx;
  opacity: 0.8;
  font-weight: normal;
}