/* ========== 背景图片 - 最底层 ========== */
.index-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
  /* 关键：让背景不拦截点击事件 */
}

.bg-image {
  width: 100%;
  height: 100%;
  display: block;
  opacity: 0.1;
  /* 背景图半透明度 */
}

/* 半透明遮罩层 - 让内容更清晰 */
.bg-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.1);
  /* 更浅的遮罩 */
}

/* ========== 自定义导航栏 ========== */
.navbar {
  width: 100%;
  color: black;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 10;
  height: 88rpx;
  padding-top: 90px;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.2);
  pointer-events: auto;
  padding-bottom: 25px;
}

.navbar-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #555555;
  letter-spacing: 6rpx;
  font-weight: 600; 
  padding-top: 45px;
}

/* ========== 页面容器 - 在背景之上 ========== */
.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 40rpx 0;
  box-sizing: border-box;
  position: relative;
  z-index: 5;
  pointer-events: none;
  /* 容器本身不拦截事件 */
}

/* ========== 页面标题 - 白色带阴影 ========== */
.page-title {
  font-size: 42rpx;
  font-weight: bold;
  color: #ffffff;
  margin: 30rpx 0 20rpx 0;
  letter-spacing: 4rpx;
  text-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.6);
  background: rgba(0, 0, 0, 0.30);
  padding: 12rpx 40rpx;
  border-radius: 40rpx;
  backdrop-filter: blur(8rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  pointer-events: auto;
  /* 标题可点击穿透 */;
}

/* ========== 关卡列表 ========== */
.levelBox {
  width: 92%;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 30rpx;
  pointer-events: auto;
  /* 让整个列表区域可交互 */;
}

/* ========== 单个关卡 - 毛玻璃效果 ========== */
.box {
  width: 42%;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  padding: 30rpx 0 25rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.25);
  transition: all 0.3s ease;
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  pointer-events: auto;
  /* 确保卡片可点击 */
  position: relative;
}

.box:active {
  transform: scale(0.96);
  background: rgba(255, 255, 255, 1);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

/* 选关图片 */
.box image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  pointer-events: none;
  /* 图片不拦截点击，让父级 box 处理 */;
}

.level-text {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #E64340;
  text-shadow: 0 2rpx 4rpx rgba(255, 255, 255, 0.5);
  pointer-events: none;
}

.level-desc {
  font-size: 22rpx;
  color: #555555;
  margin-top: 4rpx;
  text-shadow: 0 2rpx 4rpx rgba(255, 255, 255, 0.5);
  pointer-events: none;
}