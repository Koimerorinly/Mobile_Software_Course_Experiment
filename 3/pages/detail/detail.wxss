/* pages/detail/detail.wxss */
.container {
  padding: 20rpx 24rpx 180rpx;
  min-height: 100vh;
}

.detail-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.06);
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.4;
  color: #1a1a2e;
  text-align: left;
  margin-bottom: 16rpx;
}

.meta-info {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.meta-date {
  font-size: 24rpx;
  color: #999;
  background: #f5f6fa;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
}

.divider {
  height: 2rpx;
  background: linear-gradient(to right, #eee, #e0e0e0);
  margin: 20rpx 0 30rpx;
}

.poster {
  margin: 16rpx 0 30rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #f5f6fa;
}

.poster image {
  width: 100%;
  display: block;
}

.content {
  padding: 10rpx 0;
}

.content text {
  font-size: 32rpx;
  line-height: 1.8;
  color: #2d2d3f;
  letter-spacing: 1rpx;
  text-align: justify;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx 48rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  box-shadow: 0 -4rpx 30rpx rgba(0, 0, 0, 0.06);
  display: flex;
  gap: 20rpx;
  align-items: center;
  border-top: 2rpx solid rgba(0,0,0,0.03);
}

.action-bar button {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  margin: 0;
  padding: 0;
  border: none;
  transition: all 0.3s ease;
}

.action-bar button::after {
  border: none;
}

.btn-favorite {
  background: #f0f2f5;
  color: #666;
  flex: 1.2;
}

.btn-favorite.active {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: #fff;
}

.btn-home {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 24rpx rgba(102, 126, 234, 0.4);
}

.btn-home:active {
  transform: scale(0.96);
  box-shadow: 0 3rpx 12rpx rgba(102, 126, 234, 0.3);
}