/* pages/my/my.wxss */

/* 个人信息卡片 */
.profile-card {
  margin: 20rpx 24rpx 16rpx;
  padding: 40rpx 32rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 12rpx 40rpx rgba(102, 126, 234, 0.35);
  min-height: 180rpx;
  position: relative;
  overflow: hidden;
}

.profile-card::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 50%;
}

.profile-card::after {
  content: '';
  position: absolute;
  bottom: -30%;
  left: -10%;
  width: 150rpx;
  height: 150rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 50%;
}

/* 已登录状态 */
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  flex-shrink: 0;
  background: #f0f2f5;
  position: relative;
  z-index: 1;
}

.user-info {
  flex: 1;
  margin-left: 24rpx;
  position: relative;
  z-index: 1;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  display: block;
  margin-bottom: 10rpx;
}

.user-tags {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.user-badge {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.85);
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 30rpx;
  display: inline-block;
}

.logout-btn {
  padding: 10rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 30rpx;
  position: relative;
  z-index: 1;
}

.logout-btn text {
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
}

/* 未登录状态 */
.avatar-default {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

.login-info {
  flex: 1;
  margin-left: 24rpx;
  position: relative;
  z-index: 1;
}

.login-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #ffffff;
  display: block;
  margin-bottom: 6rpx;
}

.login-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.btn-login {
  background: #ffffff;
  color: #667eea;
  border: none;
  border-radius: 44rpx;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 180rpx;
  justify-content: center;
}

.btn-login::after {
  border: none;
}

.btn-icon {
  font-size: 32rpx;
}

/* 统计卡片 */
.stats-card {
  margin: 16rpx 24rpx !important;
  padding: 24rpx !important;
  background: #ffffff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex: 1;
}

.stats-divider {
  width: 2rpx;
  height: 60rpx;
  background: #f0f0f0;
}

.stats-number {
  font-size: 48rpx;
  font-weight: 700;
  color: #667eea;
}

.stats-label {
  font-size: 24rpx;
  color: #999;
}

/* 收藏列表 */
.favorites-section {
  padding: 10rpx 24rpx 40rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 8rpx 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.section-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.section-count {
  font-size: 24rpx;
  color: #999;
  background: #f0f0f0;
  padding: 4rpx 16rpx;
  border-radius: 30rpx;
}

.clear-btn {
  font-size: 24rpx;
  color: #ff6b6b;
  padding: 4rpx 12rpx;
}

/* 登录提示 */
.login-tip {
  background: #f8f9ff;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  margin-top: 20rpx;
}

.tip-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.tip-text {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 10rpx;
}

.tip-hint {
  font-size: 24rpx;
  color: #999;
}

/* 收藏列表 */
.favorites-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 16rpx;
}

.favorite-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.favorite-item:active {
  transform: scale(0.98);
}

.fav-content {
  flex: 1;
  overflow: hidden;
}

.fav-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a2e;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.fav-date {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 6rpx;
}

.fav-arrow {
  font-size: 36rpx;
  color: #ccc;
  padding-left: 20rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  background: #f8f9ff;
  border-radius: 20rpx;
  margin-top: 20rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.empty-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}